import CirclePacking.Algebraic16Data
import CirclePacking.CStar16

/-!
# The largest real root of `H16`

`q16` is defined as the largest real root of `H16`.  We show that the interval `[ql16, qh16]` (derived from
the certified bracket of `ρ*²`) is an isolating interval for it: `H16` is strictly increasing on it
(derivative certificate) and positive from `qh16` on (all coefficients of the Taylor shift at `qh16` are
positive).  Hence any root of `H16` in the interval is the largest real root.
-/

open Set

namespace CirclePacking

/-- the polynomial `H16` (Mathlib form) -/
noncomputable def H16 : Polynomial ℤ := ZPoly.toPoly H16coeffs

/-- **`q16`: the largest real root of `H16`** -/
noncomputable def q16 : ℝ := sSup {x : ℝ | Polynomial.aeval x H16 = 0}

/-- an interval for the optimum's `q = 1 - 2/ρ*²` -/
def ql16 : ℚ := 1 - 2 / P16lo
def qh16 : ℚ := 1 - 2 / P16hi

