set_option maxRecDepth 100000

theorem dH16_ok : ZPoly.beqZ (ZPoly.dP H16coeffs) dH16 = true := by decide +kernel
theorem d2H16_ok : ZPoly.beqZ (ZPoly.dP dH16) d2H16 = true := by decide +kernel

/-- the monotonicity certificate: `H16' (ql16) > (qh16 - ql16) ∑|H16''|` -/
def monoOK : Bool :=
  decide (0 ≤ ql16) && decide (ql16 ≤ qh16) && decide (qh16 ≤ 1) &&
  decide ((qh16 - ql16) * (ZPoly.absSum d2H16 : ℚ) < ZPoly.eval dH16 ql16)

theorem monoOK_true : monoOK = true := by decide +kernel

/-- no roots from `qh16` on: all coefficients of the scaled Taylor shift are positive -/
theorem shift_ok : ZPoly.posCoeffs (ZPoly.shiftS qh16.num qh16.den H16coeffs) = true := by decide +kernel

lemma aeval_H16 (x : ℝ) : Polynomial.aeval x H16 = ZPoly.eval H16coeffs x := ZPoly.aeval_toPoly _ x

/-- `H16 > 0` on `[qh16, ∞)` -/
lemma H16_pos_of_ge {x : ℝ} (hx : (qh16 : ℝ) ≤ x) : 0 < ZPoly.eval H16coeffs x := by
  set n : ℤ := qh16.num
  set m : ℤ := (qh16.den : ℤ)
  have hm : (0 : ℝ) < m := by simp only [m]; exact_mod_cast qh16.pos
  have hq : (qh16 : ℝ) = n / m := by
    simp only [n, m]; exact_mod_cast (Rat.num_div_den qh16).symm
  set z : ℝ := m * x - n
  have hz : 0 ≤ z := by
    have : (n : ℝ) / m ≤ x := by rw [← hq]; exact hx
    rw [div_le_iff₀ hm] at this
    simp only [z]; linarith
  have hx' : x = (n + z) / m := by simp only [z]; field_simp; ring
  have h := ZPoly.eval_shiftS n m hm.ne' H16coeffs z
  have hpos := ZPoly.eval_pos_of_posCoeffs shift_ok hz
  rw [h, ← hx'] at hpos
  exact pos_of_mul_pos_right hpos (pow_nonneg hm.le _)

/-- `H16` is strictly increasing on `[ql16, qh16]` -/
lemma H16_strictMonoOn : StrictMonoOn (fun x : ℝ => ZPoly.eval H16coeffs x) (Icc (ql16 : ℝ) qh16) := by
  have h := monoOK_true
  simp only [monoOK, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨h0, h01⟩, h1⟩, hcert⟩ := h
  have h0' : (0 : ℝ) ≤ ql16 := by exact_mod_cast h0
  have h1' : (qh16 : ℝ) ≤ 1 := by exact_mod_cast h1
  have hcert' : ((qh16 : ℝ) - ql16) * (ZPoly.absSum d2H16 : ℝ) < ZPoly.eval dH16 (ql16 : ℝ) := by
    have := (Rat.cast_lt (K := ℝ)).mpr hcert
    have e : ((ZPoly.eval dH16 ql16 : ℚ) : ℝ) = ZPoly.eval dH16 (ql16 : ℝ) := by
      have := ZPoly.eval_map (Rat.castHom ℝ) dH16 ql16
      simpa using this
    rw [e] at this
    push_cast at this
    exact this
  -- `|H16'' | ≤ ∑|·|` on the interval, hence `H16' > 0` there
  have hder : ∀ x ∈ Icc (ql16 : ℝ) qh16, 0 < ZPoly.eval dH16 x := by
    intro x hx
    have hb : ∀ y ∈ Icc (ql16 : ℝ) qh16, ‖ZPoly.eval d2H16 y‖ ≤ (ZPoly.absSum d2H16 : ℝ) := by
      intro y hy
      rw [Real.norm_eq_abs]
      apply ZPoly.abs_eval_le_absSum
      rw [abs_le]; constructor <;> linarith [hy.1, hy.2]
    have hd : ∀ y ∈ Icc (ql16 : ℝ) qh16,
        HasDerivWithinAt (fun y => ZPoly.eval dH16 y) (ZPoly.eval d2H16 y) (Icc (ql16 : ℝ) qh16) y := by
      intro y _
      have := (ZPoly.hasDerivAt_eval dH16 y).hasDerivWithinAt (s := Icc (ql16 : ℝ) qh16)
      rwa [ZPoly.eval_eq_of_beqZ d2H16_ok y] at this
    have hql : (ql16 : ℝ) ∈ Icc (ql16 : ℝ) qh16 := ⟨le_refl _, by exact_mod_cast h01⟩
    have hmv := (convex_Icc (ql16 : ℝ) qh16).norm_image_sub_le_of_norm_hasDerivWithin_le hd hb hql hx
    rw [Real.norm_eq_abs, Real.norm_eq_abs] at hmv
    have hxl : |x - ql16| ≤ (qh16 : ℝ) - ql16 := by
      rw [abs_le]; constructor <;> linarith [hx.1, hx.2]
    have habs : (0 : ℝ) ≤ ZPoly.absSum d2H16 := by positivity
    have : ZPoly.eval dH16 (ql16 : ℝ) - ZPoly.eval dH16 x ≤ ((qh16 : ℝ) - ql16) * ZPoly.absSum d2H16 := by
      calc _ ≤ |ZPoly.eval dH16 x - ZPoly.eval dH16 (ql16 : ℝ)| := by
            rw [abs_sub_comm]; exact le_abs_self _
        _ ≤ ZPoly.absSum d2H16 * |x - ql16| := hmv
        _ ≤ ZPoly.absSum d2H16 * ((qh16 : ℝ) - ql16) := by gcongr
        _ = _ := by ring
    linarith
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
  · exact fun x _ => (ZPoly.hasDerivAt_eval H16coeffs x).continuousAt.continuousWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    rw [(ZPoly.hasDerivAt_eval H16coeffs x).deriv, ZPoly.eval_eq_of_beqZ dH16_ok x]
    exact hder x (Ioo_subset_Icc_self hx)

/-- **A root of `H16` in `[ql16, qh16]` is the largest real root of `H16`.** -/
theorem isGreatest_of_root {x : ℝ} (hx : x ∈ Icc (ql16 : ℝ) qh16) (h0 : ZPoly.eval H16coeffs x = 0) :
    IsGreatest {y : ℝ | Polynomial.aeval y H16 = 0} x := by
  refine ⟨by simp only [mem_ofPred_eq, aeval_H16, h0], fun y hy => ?_⟩
  simp only [mem_ofPred_eq, aeval_H16] at hy
  by_contra hlt
  push Not at hlt
  by_cases hyq : y ≤ qh16
  · have := H16_strictMonoOn hx ⟨le_trans hx.1 hlt.le, hyq⟩ hlt
    simp only at this
    linarith
  · push Not at hyq
    have := H16_pos_of_ge hyq.le
    linarith

theorem q16_eq_of_root {x : ℝ} (hx : x ∈ Icc (ql16 : ℝ) qh16) (h0 : ZPoly.eval H16coeffs x = 0) : q16 = x :=
  (isGreatest_of_root hx h0).csSup_eq

end CirclePacking
